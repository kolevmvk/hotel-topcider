# Hotel Topčider — environment variables

# Javni URL aplikacije (PWA, QR kod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opciono: prikaži demo panel na produkciji
# NEXT_PUBLIC_SHOW_DEMO=true

# --- Prvi sloj pristupa (/access gate) ---

# Tajna za potpis httpOnly access cookie-ja (min. 32 karaktera u produkciji)
SITE_ACCESS_SECRET=dev-change-me-use-openssl-rand-base64-32

# JSON niz korisnika za pristup aplikaciji (server-side only, nikad u React bundle)
# Za prezentaciju: dodajte jedan objekat po pozvanom učesniku
SITE_ACCESS_USERS=[{"username":"hotel","password":"pristup123"}]
