# Vojni hotel — environment variables

# Javni URL aplikacije (PWA, QR kod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opciono: brzi ulaz u uloge + vodič za grupnu probu na /login
NEXT_PUBLIC_SHOW_DEMO=true

# --- Prvi sloj pristupa (/access gate) ---

# Tajna za potpis httpOnly access cookie-ja (min. 32 karaktera u produkciji)
SITE_ACCESS_SECRET=dev-change-me-use-openssl-rand-base64-32

# JSON niz korisnika za pristup aplikaciji (server-side only, nikad u React bundle)
# Za prezentaciju: dodajte jedan objekat po pozvanom učesniku
SITE_ACCESS_USERS=[{"username":"hotel","password":"pristup123"}]

# --- Zaštita /access gate (pred-login) ---

# reCAPTCHA v2 — https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Posle koliko grešaka tražiti reCAPTCHA (default 2)
# ACCESS_CAPTCHA_AFTER_FAILURES=2

# Posle koliko grešaka zaključati IP (default 5)
# ACCESS_LOCKOUT_AFTER_FAILURES=5

# Trajanje lockout-a u sekundama (default 900 = 15 min)
# ACCESS_LOCKOUT_SECONDS=900

# Pauza između pokušaja: base × broj grešaka, max ACCESS_RETRY_MAX_SECONDS
# ACCESS_RETRY_BASE_SECONDS=30
# ACCESS_RETRY_MAX_SECONDS=600

# --- Analitika (Supabase) ---

# composite = lokalni dev (.data/analytics-events.json); supabase = produkcija
ANALYTICS_BACKEND=composite

# Supabase (obavezno na Vercel-u za trajnu analitiku)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Tajna za middleware → POST /api/analytics/security (min. 32 karaktera)
# ANALYTICS_INTERNAL_SECRET=dev-change-me-use-openssl-rand-base64-32

# Ko sme da vidi internu analitiku (access gate username, zarezom — samo vi)
# ANALYTICS_VIEWERS=hotel

# --- Lokalni AI asistent (Ollama / Gemma) ---

# false = isključen; na Vercel bez Ollama ostavite false ili koristite fallback
ASSISTANT_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
ASSISTANT_MODEL=gemma3:4b
ASSISTANT_BACKEND=composite

# Primer profila po komandama (prošireni SITE_ACCESS_USERS):
# SITE_ACCESS_USERS=[
#   {"username":"hotel","password":"pristup123","label":"Demo","organization":"Uprava hotela","audience":"general"},
#   {"username":"gs-poseta","password":"...","organization":"Generalštab VS","audience":"executive","suggestedSteps":["/pregled","Uloga: upravnik"]},
#   {"username":"komanda-nis","password":"...","organization":"Komanda Niš","audience":"operational"},
#   {"username":"dev-kole","password":"...","audience":"developer"}
# ]
